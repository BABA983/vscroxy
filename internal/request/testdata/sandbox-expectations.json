          "want": "\"yes\""
        },
        {
          "name": "once",
          "expr": "(() => { const e = new EventEmitter(); let n = 0; e.once(\"x\", () => n++); e.emit(\"x\"); e.emit(\"x\"); return n; })()",
          "want": "1"
        },
        {
          "name": "listener count",
          "expr": "(() => { const e = new EventEmitter(); e.on(\"x\", () => {}); e.on(\"x\", () => {}); return e.listenerCount(\"x\"); })()",
          "want": "2"
        },
        {
          "name": "remove listener",
          "expr": "(() => { const e = new EventEmitter(); const fn = () => {}; e.on(\"x\", fn); e.removeListener(\"x\", fn); return e.listenerCount(\"x\"); })()",
          "want": "0"
        },
        {
          "name": "emit returns",
          "expr": "new EventEmitter().emit(\"missing\")",
          "want": "false"
