{
  "comment": "Generated by internal/request/js/sandbox/expectations.mjs with the npm versions in package-lock.json.",
  "modules": {
    "cheerio": {
      "prelude": "const cheerio = require(\"cheerio\");\nconst html = \"<html><head><title>Hello &amp; welcome</title></head><body><ul id='list'><li class='item' data-id='1'>One</li><li class='item' data-id='2'>Two</li></ul><p class='note'>A <b>bold</b> note</p></body></html>\";",
      "cases": [
        {
          "name": "title text",
          "expr": "cheerio.load(html)(\"title\").text()",
          "want": "\"Hello & welcome\""
        },
        {
          "name": "selector count",
          "expr": "cheerio.load(html)(\"#list .item\").length",
          "want": "2"
        },
        {
          "name": "attribute map",
          "expr": "cheerio.load(html)(\".item\").map(function () { return cheerio(this).attr(\"data-id\"); }).get().join(\",\")",
          "want": "\"1,2\""
        },
        {
          "name": "attribute selector",
          "expr": "cheerio.load(html)(\"li[data-id='2']\").text()",
          "want": "\"Two\""
        },
        {
          "name": "descendant selector",
          "expr": "cheerio.load(html)(\"p.note b\").text()",
          "want": "\"bold\""
        },
        {
          "name": "attribute value",
          "expr": "cheerio.load(html)(\"ul\").attr(\"id\")",
          "want": "\"list\""
        },
        {
          "name": "missing selector",
          "expr": "cheerio.load(html)(\".missing\").length",
          "want": "0"
        },
        {
          "name": "html round trip",
          "expr": "cheerio.load(\"<div><span>x</span></div>\").html()",
          "want": "\"<div><span>x</span></div>\""
        }
      ]
    },
    "xml2js": {
      "prelude": "const xml2js = require(\"xml2js\");\nconst xml = \"<root id='7'><item>A</item><item>B</item><empty/></root>\";",
      "cases": [
        {
          "name": "callback result",
          "expr": "(() => { let out; xml2js.parseString(xml, { explicitArray: false }, (err, result) => { out = result; }); return out; })()",
          "want": "{\"root\":{\"$\":{\"id\":\"7\"},\"item\":[\"A\",\"B\"],\"empty\":\"\"}}"
        },
        {
          "name": "explicit arrays",
          "expr": "(() => { let out; xml2js.parseString(xml, (err, result) => { out = result; }); return out; })()",
          "want": "{\"root\":{\"$\":{\"id\":\"7\"},\"item\":[\"A\",\"B\"],\"empty\":[\"\"]}}"
        },
        {
          "name": "attributes",
          "expr": "(() => { let out; xml2js.parseString(xml, { explicitArray: false }, (err, result) => { out = result.root.$; }); return out; })()",
          "want": "{\"id\":\"7\"}"
        },
        {
          "name": "parseStringPromise",
          "expr": "await xml2js.parseStringPromise(xml, { explicitArray: false })",
          "want": "{\"root\":{\"$\":{\"id\":\"7\"},\"item\":[\"A\",\"B\"],\"empty\":\"\"}}"
        },
        {
          "name": "async callback",
          "expr": "await new Promise((resolve) => xml2js.parseString(xml, { async: true, explicitArray: false }, (err, result) => resolve(result)))",
          "want": "{\"root\":{\"$\":{\"id\":\"7\"},\"item\":[\"A\",\"B\"],\"empty\":\"\"}}"
        },
        {
          "name": "malformed has an error",
          "expr": "(() => { let out = false; xml2js.parseString(\"<root>\", { explicitArray: false }, (err) => { out = !!err; }); return out; })()",
          "want": "true"
        }
      ]
    },
    "csv-parse/lib/sync": {
      "prelude": "const parse = require(\"csv-parse/lib/sync\");",
      "cases": [
        {
          "name": "columns",
          "expr": "parse(\"a,b\\n1,2\\n3,4\", { columns: true })",
          "want": "[{\"a\":\"1\",\"b\":\"2\"},{\"a\":\"3\",\"b\":\"4\"}]"
        },
        {
          "name": "quoted comma",
          "expr": "parse(\"a,b\\n1,\\\"x,y\\\"\", { columns: true })",
          "want": "[{\"a\":\"1\",\"b\":\"x,y\"}]"
        },
        {
          "name": "tab delimiter",
          "expr": "parse(\"a\\tb\\n1\\t2\", { delimiter: \"\\t\", columns: true })",
          "want": "[{\"a\":\"1\",\"b\":\"2\"}]"
        },
        {
          "name": "rows",
          "expr": "parse(\"a,b\\n1,2\")",
          "want": "[[\"a\",\"b\"],[\"1\",\"2\"]]"
        },
        {
          "name": "buffer input",
          "expr": "parse(Buffer.from(\"a,b\\n1,2\"), { columns: true })",
          "want": "[{\"a\":\"1\",\"b\":\"2\"}]"
        },
        {
          "name": "object name",
          "expr": "parse(\"a,b\\n1,2\", { objname: \"a\" })",
          "want": "{\"1\":\"2\",\"a\":\"b\"}"
        }
      ]
    },
    "ajv": {
      "prelude": "const Ajv = require(\"ajv\");",
      "cases": [
        {
          "name": "valid",
          "expr": "new Ajv().validate({ type: \"object\", required: [\"a\"] }, { a: 1 })",
