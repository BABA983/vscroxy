        },
        {
          "name": "invalid",
          "expr": "new Ajv().validate({ type: \"object\", required: [\"a\"] }, { b: 1 })",
          "want": "false"
        },
        {
          "name": "all errors",
          "expr": "(() => { const ajv = new Ajv({ allErrors: true }); ajv.validate({ type: \"object\", required: [\"a\", \"b\"] }, { a: 1 }); return ajv.errors.map((e) => e.keyword + \":\" + e.params.missingProperty).join(\",\"); })()",
          "want": "\"required:b\""
        },
        {
          "name": "compiled validator",
          "expr": "new Ajv().compile({ type: \"array\", items: { type: \"integer\" } })([1, 2, 3])",
          "want": "true"
        },
        {
          "name": "coerce types",
          "expr": "new Ajv({ coerceTypes: true }).validate({ type: \"object\", properties: { n: { type: \"number\" } } }, { n: \"2\" })",
          "want": "true"
        }
      ]
    },
